nb["cells"].append(md_cell(["## 2. Data Loading & Preprocessing"]))

nb["cells"].append(code_cell([
    "def load_data():\n",
    "    prices = pd.read_csv(os.path.join(TRAIN_DIR, 'stock_prices.csv'))\n",
    "    supp = pd.read_csv(os.path.join(SUPP_DIR, 'stock_prices.csv'))\n",
    "    prices = pd.concat([prices, supp], ignore_index=True)\n",
    "    prices['Date'] = pd.to_datetime(prices['Date'])\n",
    "    prices = prices.sort_values(['Date', 'SecuritiesCode']).reset_index(drop=True)\n",
    "\n",
    "    stock_list = pd.read_csv(os.path.join(DATA_DIR, 'stock_list.csv'))\n",
    "    merge_cols = ['SecuritiesCode', '33SectorCode', '33SectorName',\n",
    "                  '17SectorCode', '17SectorName', 'NewMarketSegment',\n",
    "                  'MarketCapitalization', 'Universe0']\n",
    "    prices = prices.merge(stock_list[merge_cols], on='SecuritiesCode', how='left')\n",
    "    return prices\n",
    "\n",
    "def preprocess(df):\n",
    "    df = df.sort_values(['SecuritiesCode', 'Date'])\n",
    "    df['AdjustmentFactor'] = df['AdjustmentFactor'].fillna(1.0)\n",
    "    df['CumAdjustmentFactor'] = df.groupby('SecuritiesCode')['AdjustmentFactor'].transform(\n",
    "        lambda x: x[::-1].cumprod()[::-1]\n",
    "    )\n",
    "    for col in ['Open', 'High', 'Low', 'Close']:\n",
    "        df[f'Adjusted{col}'] = df[col] / df['CumAdjustmentFactor']\n",
    "    for col in ['AdjustedOpen', 'AdjustedHigh', 'AdjustedLow', 'AdjustedClose']:\n",
    "        df[col] = df.groupby('SecuritiesCode')[col].transform(lambda x: x.ffill())\n",
    "    df['Volume'] = df.groupby('SecuritiesCode')['Volume'].transform(lambda x: x.fillna(0))\n",
    "    df['Target'] = df['Target'].replace([np.inf, -np.inf], np.nan)\n",
    "    df['ExpectedDividend'] = df['ExpectedDividend'].fillna(0)\n",
    "    return df\n",
    "\n",
    "print('Loading data...')\n",
    "df = load_data()\n",
    "print(f'Raw data: {len(df)} rows')\n",
    "df = preprocess(df)\n",
    "print(f'Preprocessed: {len(df)} rows')"
]))

nb["cells"].append(md_cell(["## 3. Feature Engineering"]))

nb["cells"].append(code_cell([
    "INF_CLIP = 1e6\n",
    "\n",
    "def build_features(df):\n",
    "    g = df.groupby('SecuritiesCode')\n",
    "\n",
    "    # Returns\n",
    "    for w in [1, 5, 10, 20, 40, 60]:\n",
    "        df[f'Return_{w}d'] = g['AdjustedClose'].transform(lambda x: x / x.shift(w) - 1).clip(-INF_CLIP, INF_CLIP)\n",
    "\n",
    "    # Volatility\n",
    "    df['DailyReturn'] = g['AdjustedClose'].transform(lambda x: x.pct_change()).clip(-INF_CLIP, INF_CLIP)\n",
    "    for w in [5, 10, 20, 60]:\n",
    "        df[f'Volatility_{w}d'] = g['DailyReturn'].transform(lambda x: x.rolling(w, min_periods=max(w//2,1)).std())\n",
    "\n",
    "    # Volume\n",
    "    for w in [5, 10, 20]:\n",
    "        rm = g['Volume'].transform(lambda x: x.rolling(w, min_periods=max(w//2,1)).mean())\n",
    "        df[f'VolumeRatio_{w}d'] = (df['Volume'] / (rm + 1)).clip(0, INF_CLIP)\n",
    "    df['VolumeChange'] = g['Volume'].transform(lambda x: x.pct_change()).clip(-INF_CLIP, INF_CLIP)\n",
    "\n",
    "    # Intraday\n",
    "    close = df['AdjustedClose'].replace(0, np.nan)\n",
    "    hl_range = df['AdjustedHigh'] - df['AdjustedLow']\n",
    "    df['IntradayRange'] = (hl_range / close).fillna(0)\n",
    "    max_oc = df[['AdjustedOpen', 'AdjustedClose']].max(axis=1)\n",
    "    min_oc = df[['AdjustedOpen', 'AdjustedClose']].min(axis=1)\n",
    "    df['UpperShadow'] = ((df['AdjustedHigh'] - max_oc) / close).fillna(0)\n",
    "    df['LowerShadow'] = ((min_oc - df['AdjustedLow']) / close).fillna(0)\n",
    "    df['BodyRatio'] = (abs(df['AdjustedClose'] - df['AdjustedOpen']) / (hl_range + 1e-8)).fillna(0)\n",
    "    df['OpenCloseReturn'] = ((df['AdjustedClose'] - df['AdjustedOpen']) / df['AdjustedOpen']).clip(-INF_CLIP, INF_CLIP).fillna(0)\n",
    "\n",
    "    # Drawdown\n",
    "    for w in [20, 40, 60]:\n",
    "        rmax = g['AdjustedClose'].transform(lambda x: x.rolling(w, min_periods=max(w//2,1)).max())\n",
    "        df[f'Drawdown_{w}d'] = (df['AdjustedClose'] / rmax - 1).clip(-1, 0).fillna(0)\n",
    "\n",
    "    # RSI\n",
    "    delta = g['AdjustedClose'].transform(lambda x: x.diff())\n",
    "    gain = delta.clip(lower=0)\n",
    "    loss = (-delta).clip(lower=0)\n",
    "    avg_gain = gain.groupby(df['SecuritiesCode']).transform(lambda x: x.ewm(alpha=1/14, adjust=False, min_periods=14).mean())\n",
    "    avg_loss = loss.groupby(df['SecuritiesCode']).transform(lambda x: x.ewm(alpha=1/14, adjust=False, min_periods=14).mean())\n",
    "    rs = avg_gain / (avg_loss + 1e-8)\n",
    "    df['RSI_14'] = (100 - 100 / (1 + rs)).fillna(50)\n",
    "\n",
    "    # MACD\n",
    "    ema_fast = g['AdjustedClose'].transform(lambda x: x.ewm(span=12, adjust=False).mean())\n",
    "    ema_slow = g['AdjustedClose'].transform(lambda x: x.ewm(span=26, adjust=False).mean())\n",
    "    df['MACD'] = ema_fast - ema_slow\n",
    "    df['MACD_Signal'] = g['MACD'].transform(lambda x: x.ewm(span=9, adjust=False).mean())\n",
    "    df['MACD_Hist'] = df['MACD'] - df['MACD_Signal']\n",
    "\n",
    "    # Bollinger\n",
    "    rmean = g['AdjustedClose'].transform(lambda x: x.rolling(20, min_periods=20).mean())\n",
    "    rstd = g['AdjustedClose'].transform(lambda x: x.rolling(20, min_periods=20).std())\n",
    "    df['BollingerPos'] = ((df['AdjustedClose'] - rmean) / (2 * rstd + 1e-8)).fillna(0)\n",
    "\n",
    "    # Dividend\n",
    "    df['DividendYield'] = (df['ExpectedDividend'] / (df['AdjustedClose'] + 1e-8)).fillna(0)\n",
    "\n",
    "    # Lagged target\n",
    "    for w in [1, 2, 3, 5, 10, 20]:\n",
    "        df[f'TargetLag_{w}d'] = g['Target'].transform(lambda x: x.shift(w))\n",
    "    df['TargetRollingMean_5d'] = g['Target'].transform(lambda x: x.shift(1).rolling(5, min_periods=1).mean())\n",
    "    df['TargetRollingMean_20d'] = g['Target'].transform(lambda x: x.shift(1).rolling(20, min_periods=5).mean())\n",
    "    df['TargetRollingStd_20d'] = g['Target'].transform(lambda x: x.shift(1).rolling(20, min_periods=5).std())\n",
    "\n",
    "    # Momentum reversal\n",
    "    df['MomentumReversal_5d'] = df['Return_5d'] - df['Return_1d']\n",
    "    df['MomentumReversal_20d'] = df['Return_1d'] - df['Return_20d']\n",
    "    df['MomentumReversal_60d'] = df['Return_1d'] - df['Return_60d']\n",
    "\n",
    "    # Cross-sectional features\n",
    "    df['ReturnRank'] = df.groupby('Date')['Return_1d'].rank(ascending=False, method='first')\n",
    "    n_s = df.groupby('Date')['SecuritiesCode'].transform('count')\n",
    "    df['ReturnRankPct'] = df['ReturnRank'] / n_s\n",
    "\n",
    "    for w in [1, 5, 20]:\n",
    "        rc = f'Return_{w}d' if w > 1 else 'Return_1d'\n",
    "        if rc in df.columns:\n",
    "            df[f'SectorReturn_{w}d'] = df.groupby(['Date', '33SectorName'])[rc].transform('mean')\n",
    "            df[f'SectorExcess_{w}d'] = df[rc] - df[f'SectorReturn_{w}d']\n",
    "\n",
    "    df['SectorRank'] = df.groupby(['Date', '33SectorName'])['Return_1d'].rank(ascending=False, method='first')\n",
    "    ss = df.groupby(['Date', '33SectorName'])['SecuritiesCode'].transform('count')\n",
    "    df['SectorRankPct'] = df['SectorRank'] / ss\n",
    "\n",
    "    df['MarketReturn_1d'] = df.groupby('Date')['Return_1d'].transform('mean')\n",
    "    df['ExcessReturn_1d'] = df['Return_1d'] - df['MarketReturn_1d']\n",
    "\n",
    "    df['VolatilityRank'] = df.groupby('Date')['Volatility_20d'].rank(ascending=False, method='first')\n",
    "    df['VolatilityRankPct'] = df['VolatilityRank'] / n_s\n",
    "    df['VolumeRank'] = df.groupby('Date')['Volume'].rank(ascending=True, method='first')\n",
    "    df['VolumeRankPct'] = df['VolumeRank'] / n_s\n",
    "\n",
    "    df['TargetLag1dRank'] = df.groupby('Date')['TargetLag_1d'].rank(ascending=False, method='first')\n",
    "    df['TargetLag1dRankPct'] = df['TargetLag1dRank'] / n_s\n",
    "\n",
    "    # Calendar\n",
    "    df['DayOfWeek'] = df['Date'].dt.dayofweek\n",
    "    df['Month'] = df['Date'].dt.month\n",
    "    df['DayOfMonth'] = df['Date'].dt.day\n",
    "    df['IsMonthStart'] = (df['DayOfMonth'] <= 5).astype(int)\n",
    "    df['IsMonthEnd'] = (df['DayOfMonth'] >= 25).astype(int)\n",
    "\n",
    "    # Momentum rank\n",
    "    for w, label in [(5, '5d'), (20, '20d'), (60, '60d')]:\n",
    "        col = f'Return_{w}d'\n",
    "        if col in df.columns:\n",
    "            df[f'MomentumRank_{label}'] = df.groupby('Date')[col].rank(ascending=False, method='first', pct=True)\n",
    "\n",
    "    # Short-term reversal\n",
    "    df['ShortTermReversal'] = df.groupby('Date')['Return_1d'].rank(ascending=True, method='first', pct=True)\n",
    "    df['Reversal_5d'] = df.groupby('Date')['Return_5d'].rank(ascending=True, method='first', pct=True)\n",
    "\n",
    "    # Sector rotation\n",
    "    sector_ret = df.groupby(['Date', '33SectorName'])['Return_1d'].mean().reset_index()\n",
    "    sector_ret = sector_ret.sort_values(['Date', 'Return_1d'], ascending=[True, False])\n",
    "    sector_ret['SectorDailyRankPct'] = sector_ret.groupby('Date').cumcount() / sector_ret.groupby('Date')['33SectorName'].transform('count')\n",
    "    df = df.merge(sector_ret[['Date', '33SectorName', 'SectorDailyRankPct']], on=['Date', '33SectorName'], how='left')\n",
    "\n",
    "    # Size factor\n",
    "    df['SizeRank'] = df.groupby('Date')['MarketCapitalization'].rank(ascending=False, method='first', pct=True)\n",
    "\n",
    "    # Market breadth\n",
    "    try:\n",
    "        sec = pd.read_csv(os.path.join(TRAIN_DIR, 'secondary_stock_prices.csv'))\n",
    "        sec_s = pd.read_csv(os.path.join(SUPP_DIR, 'secondary_stock_prices.csv'))\n",
    "        sec = pd.concat([sec, sec_s], ignore_index=True)\n",
    "        sec['Date'] = pd.to_datetime(sec['Date'])\n",
    "        sec['IsUp'] = (sec['Close'] > sec['Open']).astype(float)\n",
    "        breadth = sec.groupby('Date')['IsUp'].mean().reset_index()\n",
    "        breadth.columns = ['Date', 'MarketBreadth']\n",
    "        df = df.merge(breadth, on='Date', how='left')\n",
    "        df['MarketBreadth'] = df['MarketBreadth'].fillna(0.5)\n",
    "    except Exception:\n",
    "        df['MarketBreadth'] = 0.5\n",
    "\n",
    "    # Financial features\n",
    "    try:\n",
    "        fin = pd.read_csv(os.path.join(TRAIN_DIR, 'financials.csv'), low_memory=False)\n",
    "        fin_s = pd.read_csv(os.path.join(SUPP_DIR, 'financials.csv'), low_memory=False)\n",
    "        fin = pd.concat([fin, fin_s], ignore_index=True)\n",
    "        for c in ['NetSales', 'OperatingProfit', 'Profit', 'EarningsPerShare',\n",
    "                   'TotalAssets', 'Equity', 'EquityToAssetRatio',\n",
    "                   'ForecastProfit', 'ForecastEarningsPerShare']:\n",
    "            if c in fin.columns:\n",
    "                fin[c] = pd.to_numeric(fin[c], errors='coerce')\n",
    "        fin['Date'] = pd.to_datetime(fin['Date'])\n",
    "        fin['DisclosedDate'] = pd.to_datetime(fin['DisclosedDate'], errors='coerce')\n",
    "        fin['OperatingMargin'] = fin['OperatingProfit'] / fin['NetSales'].replace(0, np.nan)\n",
    "        fin['ROE'] = fin['Profit'] / fin['Equity'].replace(0, np.nan)\n",
    "        fin['ProfitMargin'] = fin['Profit'] / fin['NetSales'].replace(0, np.nan)\n",
    "        fin['EPS_surprise'] = (fin['EarningsPerShare'] - fin['ForecastEarningsPerShare']) / fin['ForecastEarningsPerShare'].abs().replace(0, np.nan)\n",
    "        fin['Profit_surprise'] = (fin['Profit'] - fin['ForecastProfit']) / fin['ForecastProfit'].abs().replace(0, np.nan)\n",
    "        fin = fin.sort_values(['SecuritiesCode', 'Date'])\n",
    "        for col in ['NetSales', 'Profit', 'EarningsPerShare']:\n",
    "            prev = fin.groupby('SecuritiesCode')[col].shift(4)\n",
    "            fin[f'{col}_YoY'] = (fin[col] - prev) / prev.abs().replace(0, np.nan)\n",
    "        fin_cols = ['SecuritiesCode', 'DisclosedDate', 'OperatingMargin', 'ROE', 'ProfitMargin',\n",
    "                    'EPS_surprise', 'Profit_surprise', 'EquityToAssetRatio',\n",
    "                    'NetSales_YoY', 'Profit_YoY', 'EarningsPerShare_YoY']\n",
    "        avail = [c for c in fin_cols if c in fin.columns]\n",
    "        fin_m = fin[avail].drop_duplicates(subset=['SecuritiesCode', 'DisclosedDate'], keep='last')\n",
    "        fin_m = fin_m.sort_values(['SecuritiesCode', 'DisclosedDate'])\n",
    "        ffeat = [c for c in avail if c not in ('SecuritiesCode', 'DisclosedDate')]\n",
    "        for c in ffeat:\n",
    "            df[c] = np.nan\n",
    "        for code, grp in fin_m.groupby('SecuritiesCode'):\n",
    "            mask = df['SecuritiesCode'] == code\n",
    "            p_dates = df.loc[mask, 'Date']\n",
    "            for c in ffeat:\n",
    "                if c not in grp.columns:\n",
    "                    continue\n",
    "                s = grp.set_index('DisclosedDate')[c]\n",
    "                s = s[~s.index.duplicated(keep='last')]\n",
    "                r = s.reindex(s.index.append(p_dates).sort_values()).ffill().reindex(p_dates)\n",
    "                df.loc[mask, c] = r.values\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "    # Clean\n",
    "    df = df.drop(columns=['DailyReturn'], errors='ignore')\n",
    "    return df\n",
    "\n",
    "print('Building features...')\n",
    "df = build_features(df)\n",
    "print(f'Feature engineering complete: {len(df)} rows, {len(df.columns)} columns')"
]))

nb["cells"].append(md_cell(["## 4. Get Feature Columns"]))

nb["cells"].append(code_cell([
    "EXCLUDE = {'RowId', 'Date', 'SecuritiesCode', 'Open', 'High', 'Low', 'Close',\n",
    "           'Volume', 'AdjustmentFactor', 'ExpectedDividend', 'SupervisionFlag',\n",
    "           'Target', 'CumAdjustmentFactor', 'AdjustedOpen', 'AdjustedHigh',\n",
    "           'AdjustedLow', 'AdjustedClose',\n",
    "           '33SectorCode', '33SectorName', '17SectorCode', '17SectorName',\n",
    "           'NewMarketSegment', 'MarketCapitalization', 'Universe0', 'DisclosedDate'}\n",
    "feature_cols = [c for c in df.columns if c not in EXCLUDE]\n",
    "print(f'Number of features: {len(feature_cols)}')"
]))

nb["cells"].append(md_cell(["## 5. Train Models"]))

nb["cells"].append(code_cell([
    "train_df = df[df['Date'] < VALID_START].dropna(subset=['Target'])\n",
    "valid_df = df[(df['Date'] >= VALID_START) & (df['Date'] < TEST_START)].dropna(subset=['Target'])\n",
    "print(f'Train: {len(train_df)}, Valid: {len(valid_df)}')\n",
    "\n",
    "X_train, y_train = train_df[feature_cols], train_df['Target']\n",
    "X_valid, y_valid = valid_df[feature_cols], valid_df['Target']\n",
    "\n",
    "# LightGBM regression\n",
    "dtrain = lgb.Dataset(X_train, label=y_train)\n",
    "dvalid = lgb.Dataset(X_valid, label=y_valid, reference=dtrain)\n",
    "lgb_reg = lgb.train(\n",
    "    LGB_PARAMS, dtrain, num_boost_round=N_ROUNDS,\n",
    "    valid_sets=[dtrain, dvalid], valid_names=['train', 'valid'],\n",
    "    callbacks=[lgb.early_stopping(200), lgb.log_evaluation(200)],\n",
    ")\n",
    "print(f'LGB-reg best iteration: {lgb_reg.best_iteration}')"
]))

nb["cells"].append(code_cell([
    "# LightGBM lambdarank\n",
    "train_groups = train_df.groupby('Date', sort=False).size().values\n",
    "dtrain_rank = lgb.Dataset(X_train, label=y_train, group=train_groups)\n",
    "dvalid_rank = lgb.Dataset(X_valid, label=y_valid)\n",
    "lgb_rank = lgb.train(\n",
    "    LGB_RANK_PARAMS, dtrain_rank, num_boost_round=N_ROUNDS,\n",
    "    valid_sets=[dtrain_rank, dvalid_rank], valid_names=['train', 'valid'],\n",
    "    callbacks=[lgb.early_stopping(200), lgb.log_evaluation(200)],\n",
    ")\n",
    "print(f'LGB-rank best iteration: {lgb_rank.best_iteration}')"
]))

nb["cells"].append(code_cell([
    "# XGBoost\n",
    "dxtrain = xgb.DMatrix(X_train, label=y_train)\n",
    "dxvalid = xgb.DMatrix(X_valid, label=y_valid)\n",
    "xgb_reg = xgb.train(\n",
    "    XGB_PARAMS, dxtrain, num_boost_round=N_ROUNDS,\n",
    "    evals=[(dxtrain, 'train'), (dxvalid, 'valid')],\n",
    "    early_stopping_rounds=200,\n",
    "    verbose_eval=200,\n",
    ")\n",
    "print(f'XGB best iteration: {xgb_reg.best_iteration}')"
]))

nb["cells"].append(md_cell(["## 6. Submission with Time Series API"]))

nb["cells"].append(code_cell([
    "def predict_ensemble(models, model_types, weights, X):\n",
    "    preds = []\n",
    "    for model, mtype in zip(models, model_types):\n",
    "        if mtype == 'xgb':\n",
    "            pred = model.predict(xgb.DMatrix(X))\n",
    "        else:\n",
    "            pred = model.predict(X)\n",
    "        preds.append(pred)\n",
    "    preds = np.array(preds)\n",
    "    w = np.array(weights, dtype=float)\n",
    "    w = w / w.sum()\n",
    "    return (preds * w[:, None]).sum(axis=0)\n",
    "\n",
    "MODELS = [lgb_reg, lgb_rank, xgb_reg]\n",
    "MODEL_TYPES = ['lgb', 'lgb', 'xgb']\n",
    "WEIGHTS = [1.0, 1.0, 1.0]\n",
    "\n",
    "env = make_env()\n",
    "iter_test = env.iter_test()\n",
    "\n",
    "buffer = {}\n",
